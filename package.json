{
	"name": "implementprototypeui-svelte",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#backend/modules/*": "./src/lib/backend/modules/*",
		"#backend/database/*": "./src/lib/backend/modules/database/*",
		"#frontend/modules/*": "./src/lib/frontend/modules/*",
		"#db": "./src/lib/server/db/index.ts",
		"#db/*": "./src/lib/server/db/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun ./build",
		"preview": "bun ./build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@vercel/blob": "^2.8.2",
		"better-auth": "^1.7.13",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.63.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.3",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
