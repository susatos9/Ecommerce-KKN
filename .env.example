# Base URL of the app. Use http://localhost:5173 for `bun run dev` and the
# public production origin (for example https://shop.example.com) when running
# the built Bun server.
BETTER_AUTH_URL=http://localhost:5173

# Generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Public origin used by SvelteKit when running the built server over
# plain HTTP (for example http://localhost:3000). Leave empty behind TLS.
ORIGIN=

# Optional adapter-bun server settings
# HOST=0.0.0.0
# PORT=3000
# BODY_SIZE_LIMIT=512K
# SHUTDOWN_TIMEOUT=30
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# PORT_HEADER=x-forwarded-port
# ADDRESS_HEADER=true-client-ip
